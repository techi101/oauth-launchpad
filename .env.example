# Live research model (at least one required for the "Research an app" flow)
GEMINI_API_KEY=your-gemini-key
# Optional: comma-separated Gemini models tried in order
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# Optional fallback model
DEEPSEEK_API_KEY=your-deepseek-key

# Durable storage for generated guides (required in production; local dev falls back to ./.data)
BLOB_READ_WRITE_TOKEN=vercel-blob-token

# Optional: web search widens discovery for providers outside the catalog (one of these)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: JS-rendered docs fallback via Jina Reader ("off" disables it)
READER_FALLBACK=on
JINA_API_KEY=

# Optional: total research time budget in ms
RESEARCH_BUDGET_MS=230000
